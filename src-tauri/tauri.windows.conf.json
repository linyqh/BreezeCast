{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BreezeCast",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": { "binaries/windows/*": "." },
    "windows": {
